rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Ana's signed-in account can read or write entries.
    match /wins/{winId} {
      allow read, write: if request.auth != null
        && request.auth.uid == "opvIaicjPUb778wuUuUOQvjafM53";
    }
  }
}
